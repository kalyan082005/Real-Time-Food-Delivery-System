# Vite Environment Variables for Microservices Architecture
# Note: Variables must be prefixed with VITE_ to be accessible in the browser

# API Gateway Configuration (Single Entry Point)
VITE_API_GATEWAY_URL=http://localhost:8088
VITE_API_URL=http://localhost:8088/api
VITE_WEBSOCKET_URL=ws://localhost:8088/ws

# Stripe Configuration (Payment Processing)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51TGiJRPt1zA7x93ZPM9gKQ3Trvw2HyEDW6G0dzDjhlxslVKWyP71xq5WQAQRqDn2OOnWxCDLpPMzgIYwCgXx9BYk00p0AqfknA

# Google Maps API (for delivery tracking)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# App Environment
VITE_NODE_ENV=development

# App Information
VITE_APP_NAME=Food Delivery App - Microservices
VITE_APP_VERSION=2.0.0

# Feature Flags
VITE_ENABLE_PAYMENT=true
VITE_ENABLE_REAL_TIME_TRACKING=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_MICROSERVICES_MONITORING=true

# Service Discovery (for development)
VITE_USER_SERVICE_URL=http://localhost:8081
VITE_RESTAURANT_SERVICE_URL=http://localhost:8082
VITE_ORDER_SERVICE_URL=http://localhost:8083
VITE_PAYMENT_SERVICE_URL=http://localhost:8084
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8085
VITE_DELIVERY_SERVICE_URL=http://localhost:8086